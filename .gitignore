# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests/*
!tests/forward-forecast.test.mjs
!tests/forward-forecast.browser.cjs
!tests/forecast-map-browser.test.cjs
!tests/spatial-scan.browser.cjs
!tests/time-player.test.mjs

# next.js
/.next/
/out/

# production
/build

# misc & certificates/keys
.DS_Store
*.pem
*.key
*.cert
*.id_rsa

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# task
TASK.md
# Generated local patch dump
/diff.txt

# SQL scripts and internal migration/security files
*.sql
scripts/

# Security audit logs and sensitive security notes
QA_SECURITY_AUDIT_LOG.md
docs/*security*.md

# Graphify knowledge graph outputs
graphify-out/

# Tests folder is ignored, except for the specific test files that are needed for CI/CD and coverage reports
/tests/*
!/tests/dashboard-query-client.test.mjs
!/tests/role-layout.browser.cjs
!/tests/table-design.browser.cjs
!/tests/map-pin-consistency.test.mjs
