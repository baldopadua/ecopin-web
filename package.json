{
  "name": "ecopin-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "next dev -p 4001 --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:public-map": "node --test --test-isolation=none tests/public-report-page.test.mjs",
    "test:reports": "node --env-file=.env --test tests/reports-access.test.mjs",
    "test:storage": "node --env-file=.env --test --test-isolation=none tests/storage-access.test.mjs",
    "test:preview": "node --test --test-isolation=none tests/preview-authorization.test.mjs",
    "test:headers": "node --test --test-isolation=none tests/security-headers.test.mjs tests/pin-icon.test.mjs tests/dashboard-caching-proxy.test.mjs",
    "test:caching": "node --test --test-isolation=none tests/dashboard-caching-proxy.test.mjs",
    "test:preview-quota-live": "node --env-file=.env --test --test-isolation=none tests/preview-quota-live.test.mjs",
    "test:forecast-browser": "node --test --test-isolation=none tests/forecast-map-browser.test.cjs",
    "test:analytics": "node --test --test-isolation=none tests/report-analytics.test.mjs tests/sweeper-analytics.test.mjs",
    "test:sweeper-settings": "node --test --test-isolation=none tests/sweeper-config.test.mjs",
    "test:optimization-settings": "node --test --test-isolation=none tests/optimization-settings.test.mjs",
    "test:multi-lgu": "node --test --test-isolation=none tests/multi-lgu-isolation.test.mjs",
    "test:apm": "node --test --test-isolation=none tests/apm-monitoring.test.mjs tests/infrastructure-page.test.mjs tests/staging-preview-audit.test.mjs",
    "test:preview-audit": "node --test --test-isolation=none tests/staging-preview-audit.test.mjs",
    "test": "npm run test:public-map && node --test tests/rate-limiter.test.mjs && node --test tests/private-media.test.mjs && node --test tests/optimization-response.test.mjs && node --test tests/optimization-settings.test.mjs && node --env-file=.env --test tests/batch-evidence-cache.test.mjs && npm run test:reports && npm run test:storage && npm run test:analytics && npm run test:preview && npm run test:headers && npm run test:diagnostics && npm run test:session-credentials && npm run test:session-store && npm run test:session-routes && npm run test:backend-policy && npm run test:multi-lgu && npm run test:apm",
    "test:diagnostics": "node --test --test-isolation=none tests/diagnostics.test.mjs",
    "test:diagnostics-browser": "node --test --test-isolation=none tests/diagnostics-browser.test.cjs",
    "test:production-routes": "node --test --test-isolation=none tests/production-routes.test.mjs",
    "test:session-credentials": "node --test --test-isolation=none tests/session-credentials.test.mjs",
    "test:session-store": "node --test --test-isolation=none tests/web-session-store.test.mjs",
    "test:session-routes": "node --test --test-isolation=none tests/web-session-routes.test.mjs",
    "test:backend-policy": "node --test --test-isolation=none tests/backend-policy.test.mjs",
    "test:service-role-bundle": "node --test tests/service-role-bundle.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.101.4",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.47.0",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "^5.0.0-rc.0",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "wkx": "^0.5.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
